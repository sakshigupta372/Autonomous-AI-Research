GROQ_API_KEY=gsk_your-key-here

# Get a free key (no credit card required) at https://console.groq.com/keys

# Optional overrides. Other free Groq models: llama-3.1-8b-instant (faster, smaller)
RESEARCH_AGENT_MODEL=llama-3.3-70b-versatile
RESEARCH_AGENT_MAX_PAPERS=3
RESEARCH_AGENT_CRITIC_THRESHOLD=7.0
RESEARCH_AGENT_MAX_REFLECTION_ROUNDS=2
RESEARCH_AGENT_SANDBOX_TIMEOUT=30
RESEARCH_AGENT_ENABLE_EXPERIMENTS=true
